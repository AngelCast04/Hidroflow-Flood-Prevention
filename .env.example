# Copia a .env.local (no se sube a git) o configura en Render → Environment.
# OpenAI (chat + embeddings)
OPENAI_API_KEY=

# Supabase (RAG). URL en Settings → API → Project URL
SUPABASE_URL=https://TU_REF.supabase.co
# Anon (público, limitado) o Service Role solo en servidor / script de indexado
SUPABASE_ANON_KEY=
# Opcional: para npm run rag:index:spatial (insertar chunks; no uses en el navegador)
SUPABASE_SERVICE_ROLE_KEY=
